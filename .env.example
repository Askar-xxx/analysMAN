# Скопируй этот файл в .env и заполни реальными значениями:
#   cp .env.example .env
# Файл .env НЕ коммитится в репозиторий.

# === Telegram ===
TELEGRAM_TOKEN=your_telegram_bot_token

# === AI (DeepSeek) ===
DEEPSEEK_API_KEY=your_deepseek_api_key

# === TheSportsDB Premium API ($9/мес) ===
THESPORTSDB_KEY=your_thesportsdb_premium_key

# === DonationAlerts OAuth ===
DA_CLIENT_ID=your_da_client_id
DA_CLIENT_SECRET=your_da_client_secret
DA_REDIRECT_URI=http://localhost:8080/callback

# === DonationAlerts токены (заполняются автоматически через: python da_oauth.py) ===
DA_ACCESS_TOKEN=
DA_REFRESH_TOKEN=

# === DonationAlerts настройки ===
DA_PROFILE_URL=https://www.donationalerts.com/r/your_username

# === Бизнес-параметры ===
ANALYSIS_PRICE_RUB=150

# === Администратор ===
MAIN_ADMIN_ID=your_telegram_id
SUPPORT_USERNAME=your_support_username
