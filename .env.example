# Скопируй этот файл в .env и заполни реальными значениями:
#   cp .env.example .env
# Файл .env НЕ коммитится в репозиторий.

# === Telegram ===
TELEGRAM_TOKEN=your_telegram_bot_token
# Замени на свой Telegram chat_id для ERROR/CRITICAL алертов
ALERT_CHAT_ID=847033482
# Локально можно отключить отправку Telegram-алертов, не влияя на прод
DISABLE_TELEGRAM_ALERTS=0

# === AI (DeepSeek) ===
DEEPSEEK_API_KEY=your_deepseek_api_key
# Количество повторных LLM-переписываний после quality-check (0 = отключено, без доп. API-вызовов)
AI_QUALITY_REWRITE_ATTEMPTS=0

# === TheSportsDB Premium API ($9/мес) ===
THESPORTSDB_KEY=your_thesportsdb_premium_key
# Проверка TLS-сертификата для HTTPS-запросов к TheSportsDB (рекомендуется true)
THESPORTSDB_VERIFY_TLS=true

# === DonationAlerts OAuth ===
DA_CLIENT_ID=your_da_client_id
DA_CLIENT_SECRET=your_da_client_secret
DA_REDIRECT_URI=http://localhost:8080/callback

# === DonationAlerts токены (заполняются автоматически через: python da_oauth.py) ===
DA_ACCESS_TOKEN=
DA_REFRESH_TOKEN=

# === DonationAlerts настройки ===
DA_PROFILE_URL=https://www.donationalerts.com/r/your_username

# === Бизнес-параметры ===
ANALYSIS_PRICE_RUB=150

# === Администратор ===
ADMIN_ID=your_telegram_id,437029227
SUPPORT_USERNAME=your_support_username

# === Dev/Test fault-injection flags (по умолчанию выключены) ===
FORCE_TABLE_TIMEOUT=0
FORCE_TABLE_ERROR=0
FORCE_PROGRESS_BADREQUEST=0
FORCE_SEND_ERROR=0
